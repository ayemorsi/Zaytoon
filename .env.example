# ─── Supabase (client-side, safe to expose) ────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Plaid (client-side — environment only, no secrets) ─────────────────────────
# Use 'sandbox' for dev, 'production' for release builds
EXPO_PUBLIC_PLAID_ENV=sandbox

# ─── Stripe (client-side publishable key only) ──────────────────────────────────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key

# ─── Google OAuth (from Google Cloud Console) ───────────────────────────────────
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com

# ─── SERVER-SIDE SECRETS (Supabase Edge Function env vars, never in app bundle) ─
# Set these in the Supabase Dashboard → Project Settings → Edge Functions → Secrets
# or via: supabase secrets set KEY=value

# PLAID_CLIENT_ID=your-plaid-client-id
# PLAID_SECRET=your-plaid-secret-key       # sandbox vs production key
# PLAID_ENV=sandbox                         # sandbox | development | production

# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # auto-injected in Edge Functions

# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key        # for charge processing
# STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret  # from Stripe Dashboard → Webhooks

# ─── Push Notifications (Story 007) ─────────────────────────────────────────────
# No additional secrets needed — Expo Push Service handles APNs/FCM routing.
# EAS project ID (from eas.json / Expo dashboard) is read automatically from Constants.

# ─── Friday Cron (Story 009) ─────────────────────────────────────────────────────
# pg_cron reads these Postgres settings from the database. Set them BEFORE running
# the 20260523000004_friday_cron.sql migration:
#
#   psql $DATABASE_URL -c "ALTER DATABASE postgres SET \"app.supabase_url\" = 'https://YOUR_REF.supabase.co';"
#   psql $DATABASE_URL -c "ALTER DATABASE postgres SET \"app.service_role_key\" = 'YOUR_SERVICE_ROLE_KEY';"
